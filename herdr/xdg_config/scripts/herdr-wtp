#!/usr/bin/env bash
# herdr-wtp — create (or resume) a Git worktree via `wtp`, then open it as a
# Herdr workspace. Uses `wtp add` so .wtp.yaml hooks (file copying, setup) run.
#
# Wired in config.toml as a type="popup" modal keybind so fzf gets a real TTY
# floating over the current tab. Runs in the focused pane's repo
# (HERDR_ACTIVE_PANE_CWD), so trigger it from a project.
set -uo pipefail

cd "${HERDR_ACTIVE_PANE_CWD:-$PWD}" 2>/dev/null || exit 0

# Pick an existing branch, or type a new name (created with `wtp add -b`).
branches=$({ git for-each-ref --format='%(refname:short)' refs/heads
             git for-each-ref --format='%(refname:short)' refs/remotes | grep / | sed 's#^origin/##'
           } | grep -vx HEAD | sort -u)
out=$(printf '%s\n' "$branches" | fzf --reverse --print-query \
        --border=rounded --border-label=' worktree: create / resume ' \
        --prompt "worktree branch> " \
        --header "Enter on an existing branch, or type a new name + Enter")
query=$(sed -n '1p' <<<"$out"); choice=$(sed -n '2p' <<<"$out")

if   [[ -n $choice ]]; then branch=$choice; new=""
elif [[ -n $query  ]]; then branch=$query;  new="-b"
else exit 0; fi

# Resolve first: an existing worktree for this branch resumes without touching it.
path=$(wtp cd "$branch" 2>/dev/null | tail -n1)

# Otherwise create it. `wtp add` has no -q flag and its success banner's last
# line is a `wtp cd` hint (not the path), so never parse its stdout: run it for
# the side effect, surface any real failure verbatim, then re-resolve via `wtp cd`.
if [[ -z $path ]]; then
  if ! err=$(wtp add $new "$branch" 2>&1 >/dev/null); then
    printf "wtp add failed for '%s':\n%s\n" "$branch" "$err" >&2; sleep 3; exit 1
  fi
  path=$(wtp cd "$branch" 2>/dev/null | tail -n1)
fi
[[ -z $path ]] && { echo "wtp: couldn't resolve worktree path for '$branch'"; sleep 3; exit 1; }

# Create-or-resume the Herdr workspace for that worktree (label = dir name).
name=$(basename "$path" | tr . _)
id=$(herdr workspace list | jq -r --arg n "$name" \
       '.result.workspaces[] | select(.label == $n) | .workspace_id' | head -n1)
[[ -n $id ]] && herdr workspace focus "$id" || herdr workspace create --cwd "$path" --label "$name" --focus
